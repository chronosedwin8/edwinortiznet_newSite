# ---------------------------------------------------------------
# edwinortiz.net — variables de entorno
# Copia este archivo como .env (fuera del webroot) y completa los valores.
# ---------------------------------------------------------------

# Aplicación
APP_ENV=production            # production | local
APP_DEBUG=false               # true solo en desarrollo: muestra errores detallados
APP_URL=https://www.edwinortiz.net
APP_KEY=                      # 64 caracteres hex aleatorios: php -r "echo bin2hex(random_bytes(32));"
APP_TIMEZONE=America/Bogota
PAGE_CACHE=true               # caché de página completa en disco
PAGE_CACHE_TTL=3600           # segundos
NOINDEX=false                 # true en el subdominio de pruebas: añade noindex a todo

# Base de datos (MySQL 8)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=edwinortiz
DB_USER=edwinortiz
DB_PASS=

# Correo (PHPMailer). MAIL_DRIVER=smtp en producción; "log" guarda los correos en storage/logs/mail/
# Amazon SES: MAIL_USERNAME = Access key ID del usuario IAM; MAIL_PASSWORD = contraseña SMTP derivada:
#   php bin/console mail:ses-password us-east-1   (pide la clave secreta IAM y muestra la contraseña SMTP)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls           # tls | ssl | none
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hola@edwinortiz.net
MAIL_FROM_NAME="Edwin Ortiz Herazo"
ADMIN_EMAIL=chronosedwin8@gmail.com   # recibe el aviso de cada venta y los mensajes de contacto

# Tienda
USD_COP_RATE=4000             # tasa usada por el seed para calcular price_cop (redondeado al millar)
DOWNLOAD_MAX=5                # descargas por enlace
DOWNLOAD_DAYS=30              # vigencia del enlace de descarga
DOWNLOAD_ACCEL=false          # true con Nginx: entrega con X-Accel-Redirect (/protected-downloads/)

# Mercado Pago (Checkout Pro, COP)
MP_MODE=sandbox               # sandbox | production
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=            # "Clave secreta" de Webhooks en Tus integraciones

# Wompi (COP)
WOMPI_MODE=sandbox            # sandbox | production
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# PayPal (USD, solo pedidos en inglés; cuenta Business)
PAYPAL_MODE=sandbox           # sandbox | production
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Analítica y anuncios (se cargan solo tras el consentimiento)
GA4_ID=                       # G-XXXXXXXXXX
ADSENSE_CLIENT=               # ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_SLOT_TOP=
ADSENSE_SLOT_MIDDLE=
ADSENSE_SLOT_BOTTOM=

# Contacto
WHATSAPP_NUMBER=573162830615

# Pasarelas ocultas en el checkout mientras no tengan credenciales de producción (ej.: wompi)
GATEWAYS_DISABLED=

# Archivos subidos desde el panel en Amazon S3 (imágenes públicas, archivos de producto privados con URL firmada).
# STORAGE_DISK=local los guarda en el servidor (desarrollo). Para mover lo existente: php bin/console storage:s3
STORAGE_DISK=local
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_S3_KEY=
AWS_S3_SECRET=
AWS_S3_PUBLIC_URL=

# PIAR con IA (Google Gemini). La clave va en la cabecera x-goog-api-key, nunca en la URL ni en los registros.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_ASSIST_MODEL=gemini-2.5-flash
# Generador de exámenes: modelo (por defecto gemini-2.5-flash) y ruta de Node para las fórmulas LaTeX (opcional; por defecto /usr/bin/node).
EXAMENES_MODEL=gemini-2.5-flash
NODE_BINARY=

# Redes sociales (Facebook e Instagram) con la app de Meta «Minuevoblog». Los tokens de página se guardan cifrados
# en la base (clave derivada de APP_KEY); el token de usuario solo se usa para conectar (panel o social:connect).
META_APP_ID=
META_APP_SECRET=
META_USER_TOKEN=              # opcional: para `php bin/console social:connect`; también se puede pegar en /admin/redes/ajustes/
META_GRAPH_VERSION=v23.0
# Disparador externo opcional (EventBridge/Lambda): GET o POST https://www.edwinortiz.net/cron/redes/<SOCIAL_CRON_TOKEN>/
# Vacío = apagado. Mínimo 32 caracteres [A-Za-z0-9_-]: php -r "echo bin2hex(random_bytes(24));"
SOCIAL_CRON_TOKEN=

# Boletín: dirección del enlace de baja por correo (cabecera List-Unsubscribe, además del de un clic por HTTPS).
# Por omisión, MAIL_FROM_ADDRESS. Esas solicitudes llegan a ese buzón y se procesan a mano (Gmail y Yahoo usan el de un clic).
NEWSLETTER_UNSUBSCRIBE_MAILTO=

# Cloudflare Turnstile (anti-bots gratuito) en suscripción, contacto, lista de espera y acceso a PIAR y exámenes.
# Vacío = apagado. Claves gratis en dash.cloudflare.com → Turnstile → Add widget (dominio www.edwinortiz.net, modo "Managed").
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Topes globales de correos de confirmación de suscripción (bajarlos durante un ataque de bots)
SUBSCRIBE_MAIL_CAP_HOUR=15
SUBSCRIBE_MAIL_CAP_DAY=60
